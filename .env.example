# Copy to .env and fill in what you use. Everything is optional except SMTP for sending email.

# --- AI writer (pick ONE; all have free tiers except Claude) ---
GEMINI_API_KEY=            # free: https://aistudio.google.com/apikey
GROQ_API_KEY=              # free: https://console.groq.com/keys
OLLAMA_MODEL=              # free, local: e.g. llama3.1 (install https://ollama.com)
ANTHROPIC_API_KEY=         # paid, best writing quality (pip install "leadscout[claude]")

# --- Optional data sources ---
GOOGLE_PLACES_API_KEY=     # adds ratings/reviews; free monthly quota on Google Cloud
PAGESPEED_API_KEY=         # free key for Google PageSpeed Insights

# --- Email sending (Gmail: enable 2FA, then create an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# IMAP for reply detection (defaults to the SMTP user/password)
IMAP_HOST=imap.gmail.com

# --- Optional exports ---
GOOGLE_SERVICE_ACCOUNT_FILE=   # path to service-account JSON (pip install "leadscout[sheets]")
HUBSPOT_TOKEN=                 # HubSpot private app token
